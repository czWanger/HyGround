# One OpenAI-compatible endpoint serves every API-backed component.
HYQ_API_BASE=https://api.openai.com/v1
HYQ_API_KEY=sk-your-key

# Optional: executor reflection model (defaults to the planner model when unset).
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional overrides
# HYQ_JUDGE_MODEL=gpt-4.1
# LOTUS_LM_MODEL=gpt-4.1
# HYQ_DATA_DIR=./data
# HYQ_OUTPUT_DIR=./outputs
